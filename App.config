<?xml version="1.0" encoding="utf-8"?>
<!--
  App.config – CHUNG cho cả nhóm, có đưa lên Git.
  Chuỗi kết nối KHÔNG viết ở đây mà nằm trong connectionStrings.config (riêng từng máy).
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings configSource="connectionStrings.config" />
</configuration>
