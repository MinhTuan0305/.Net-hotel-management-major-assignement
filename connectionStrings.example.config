<?xml version="1.0" encoding="utf-8"?>
<!--
  MẪU chuỗi kết nối – có đưa lên Git.
  Mỗi người chép file này thành connectionStrings.config (KHÔNG đưa lên Git) rồi sửa Server:
    - SQL Server Express mặc định : Server=.\SQLEXPRESS
    - Bản Developer / mặc định    : Server=localhost   (hoặc Server=.)
  Integrated Security=True: đăng nhập bằng tài khoản Windows (giống khi mở SSMS).
  Nếu dùng tài khoản SQL (sa...): thay bằng User ID=sa;Password=...
-->
<connectionStrings>
  <add name="HotelDb"
       connectionString="Server=.\SQLEXPRESS;Database=HotelManagement;Integrated Security=True"
       providerName="System.Data.SqlClient" />
</connectionStrings>
